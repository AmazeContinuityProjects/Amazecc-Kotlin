<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F172A"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AmazeCC • Upcoming Tasks"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_task_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Tasks"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/widget_empty_tasks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="🎉 No pending tasks due soon!"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Task Item 1 -->
    <LinearLayout
        android:id="@+id/widget_task1_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="8dp"
        android:layout_marginBottom="6dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_task1_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CSE1001"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task1_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Due Today"
                android:textColor="#F59E0B"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task1_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete Lab Assignment 3"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_task1_subtasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtasks: 2/3 done"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Task Item 2 -->
    <LinearLayout
        android:id="@+id/widget_task2_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E293B"
        android:padding="8dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_task2_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ECE2002"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_task2_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Tomorrow"
                android:textColor="#94A3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_task2_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Prepare Quiz 2 Notes"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/widget_task2_subtasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subtasks: 0/1 done"
            android:textColor="#94A3B8"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
