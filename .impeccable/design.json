      "css": ".ds-group{display:inline-flex;gap:4px;background:#0F1014;border-radius:24px;padding:4px}.ds-group-segment{background:transparent;color:#C4C6D0;border:none;border-radius:20px 8px 8px 20px;padding:9px 16px;font:500 13px Roboto,sans-serif;cursor:pointer;transition:background 200ms,color 200ms}.ds-group-segment:last-child{border-radius:8px 20px 20px 8px}.ds-group-segment:hover{color:#E3E2E6}.ds-group-segment:focus-visible{outline:2px solid #A8C7FA;outline-offset:2px}.ds-group-selected,.ds-group-selected:hover{background:#A8C7FA;color:#003062;border-radius:18px;font-weight:600;display:flex;align-items:center;gap:6px}"
