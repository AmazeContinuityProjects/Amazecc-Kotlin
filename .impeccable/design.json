      "description": "Tonal container with a hairline border; interactive variants compress on press.",
      "html": "<div class=\"ds-surface-card\" tabindex=\"0\" role=\"button\"><span class=\"ds-surface-card-label\">ATTENDANCE</span><div class=\"ds-surface-card-value\">82%</div></div>",
      "css": ".ds-surface-card{background:#16171D;color:#E3E2E6;border:1px solid rgba(51,53,62,0.5);border-radius:20px;padding:16px;transition:transform 260ms cubic-bezier(0.34,1.56,0.64,1);cursor:pointer}.ds-surface-card:hover{background:#1E2028;border-color:rgba(142,144,153,0.7)}.ds-surface-card:focus-visible{outline:2px solid #A8C7FA;outline-offset:2px}.ds-surface-card:active{transform:scale(0.97)}.ds-surface-card-label{font:700 10px Roboto,sans-serif;letter-spacing:1px;color:#C4C6D0;text-transform:uppercase}.ds-surface-card-value{font:900 24px Roboto,sans-serif;letter-spacing:-0.5px;margin-top:6px}"
    },
